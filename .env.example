# Database configuration
POSTGRES_USER=claimgraph
POSTGRES_PASSWORD=claimgraph
POSTGRES_DB=claimgraph
DATABASE_URL=postgresql+psycopg://claimgraph:claimgraph@db:5432/claimgraph

# Backend configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
STORAGE_DIR=./storage

# Frontend configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM configuration (Groq OpenAI-compatible endpoint)
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Extraction model supporting json_schema strict mode (e.g. openai/gpt-oss-120b)
LLM_EXTRACT_MODEL=openai/gpt-oss-120b
# Small, fast model for classification (e.g. openai/gpt-oss-20b)
LLM_CLASSIFY_MODEL=openai/gpt-oss-20b
LLM_MODE=replay
LLM_MAX_CONCURRENCY=2
